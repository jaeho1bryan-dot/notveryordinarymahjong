{
  "name": "@mahjong/server",
  "version": "0.1.0",
  "private": true,
  "description": "Colyseus game server driving the riichi mahjong engine",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.14",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/ws-transport": "^0.18.2",
    "@mahjong/shared": "*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
